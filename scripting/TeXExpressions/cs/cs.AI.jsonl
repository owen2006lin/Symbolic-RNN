{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation", "index": 0, "latex": "\\begin{equation}\n\\label{eq:additive_fa}\ng(z') = \\phi_0 + \\sum_{i = 1}^M \\phi_i z_i',\n\\end{equation}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation", "index": 1, "latex": "\\begin{equation}\n\\label{eq:local_lime}\n\\xi = \\mathop{{\\arg\\min}\\vphantom{\\sim}}\\limits_{\\displaystyle _{g \\in \\mathcal{G}}}  ~ L(f, g, \\pi_{x'}) + \\Omega(g).\n\\end{equation}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation", "index": 2, "latex": "\\begin{equation}\n\\label{eq:sum_to_delta}\n\\sum_{i=1}^n C_{\\Delta x_i \\Delta o} = \\Delta o,\n\\end{equation}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation", "index": 3, "latex": "\\begin{equation}\n\\label{eq:shapley1}\n\\phi_i = \\sum_{S \\subseteq F \\setminus \\{i\\}} \\frac{|S|!(|F| - |S| -1)!}{|F|!} \\left [ f_{S \\cup \\{i\\}}(x_{S \\cup \\{i\\}}) - f_S(x_S) \\right ].\n\\end{equation}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation", "index": 4, "latex": "\\begin{equation}\nf(x) = g(x') = \\phi_0 + \\sum_{i = 1}^M \\phi_i x_i'\n\\end{equation}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation", "index": 5, "latex": "\\begin{equation}\nx'_i = 0 \\implies \\phi_i = 0\n\\end{equation}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation", "index": 6, "latex": "\\begin{equation}\nf'_x(z') - f'_x(z' \\setminus i) \\ge f_x(z') - f_x(z' \\setminus i)\n\\end{equation}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation", "index": 7, "latex": "\\begin{equation}\n\\phi_i(f,x) = \\sum_{z' \\subseteq x'} \\frac{|z'|!(M - |z'| -1)!}{M!} \\left [ f_x(z') - f_x(z' \\setminus i) \\right ]\n\\label{eq:shapley}\n\\end{equation}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:align", "index": 8, "latex": "\\begin{align}\nf(h_x(z')) &= E[f(z) \\mid z_S] & \\text{SHAP explanation model simplified input mapping} \\\\\n &= E_{z_{\\bar S} \\mid z_S} [f(z)] & \\text{expectation over $z_{\\bar S} \\mid z_S$} \\\\\n &\\approx E_{z_{\\bar S}} [f(z)] & \\text{assume feature independence (as in \\cite{vstrumbelj2014explaining,ribeiro2016should,shrikumar2017learning,datta2016algorithmic}) } \\label{eq:indep} \\\\\n &\\approx f([z_S,E[z_{\\bar S}]]). & \\text{assume model linearity} \\label{eq:indep_lin}\n\\end{align}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation*", "index": 9, "latex": "\\begin{equation*}\n\\begin{split}\n\\Omega(g) &= 0, \\\\\n\\pi_{x'}(z') &= \\frac{(M-1)}{(M~choose~|z'|) |z'| (M - |z'|)}, \\\\\nL(f,g,\\pi_{x'}) &= \\sum_{z' \\in Z} \\left[ f(h_x^{-1}(z')) - g(z') \\right]^2 \\pi_{x'}(z'), \\\\\n\\label{eq:kernel}\n\\end{split}\n\\end{equation*}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:equation*", "index": 10, "latex": "\\begin{equation*}\n\\phi_i(f,x) = w_j (x_j - E[x_j])\n\\end{equation*}"}
{"arxiv_id": "1705.07874", "cited_by_count": 7621, "arxiv_primary_category": "cs.AI", "file": "main.tex", "kind": "environment:align", "index": 11, "latex": "\\begin{align}\nm_{x_j f_3} &= \\frac{\\phi_i(f_3,x)}{x_j - E[x_j]} \\\\\n\\forall_{j \\in \\{1,2\\}} ~~~  m_{y_i f_j} &= \\frac{\\phi_i(f_j,y)}{y_i - E[y_i]} \\\\\nm_{y_i f_3} &= \\sum_{j=1}^2 m_{y_i f_j}m_{x_j f_3} & \\text{chain rule} \\\\\n\\phi_i(f_3,y) &  \\approx m_{y_i f_3}(y_i - E[y_i]) & \\text{linear approximation}\n\\end{align}"}
