{"arxiv_id": "1512.02325", "cited_by_count": 20045, "arxiv_primary_category": "cs.CV", "file": "0348.tex", "kind": "environment:equation", "index": 2, "latex": "\\begin{equation}\nL_{conf}(x, c) = - \\sum_{i\\in Pos}^N x_{ij}^p log(\\hat{c}_i^p) - \\sum_{i\\in Neg} log(\\hat{c}_i^0)\\quad\\text{where}\\quad\\hat{c}_i^p = \\frac{\\exp(c_i^p)}{\\sum_p \\exp(c_i^p)}\n\\label{eq:confloss}\n\\end{equation}"}
