{"arxiv_id": "1910.11333", "cited_by_count": 6595, "arxiv_primary_category": "quant-ph", "file": "sup_xeb_theory.tex", "kind": "environment:multline", "index": 16, "latex": "\\begin{multline} \\label{eq:xeb_exp}\n \\frac{1}{S N_s} \\sum_{j=1}^{S}\\sum_{i=1}^{N_s} \\left( D p_s^j(q_{i,j}) -1\\right) \\\\= \\overline{\\avg{  D p_s(q) - 1}} +\n O\\left( \\frac{1} {\\sqrt{S N_s}} \\right)\\;.\n\\end{multline}"}
